@hostname = localhost
@port = 3000
@host={{hostname}}:{{port}}
@protocol = http
@version = v1
@baseurl = {{protocol}}://{{host}}/{{version}}
###
POST {{baseurl}}/users
Content-Type: application/json

{
  "id": 1,
  "name": "John Doe",
  "email": "example@gmail.com",
  "gender": "FEMALE"
}

